# OS
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
npm-debug.log*

# Local env / secrets
.env
.env.local

# Claude Code local settings (if ever created inside this folder)
.claude/settings.local.json
# local dev-server launch config for the in-editor preview — tooling, not site
.claude/launch.json

# Working briefs written for Claude Code sessions. They stay on disk as a local
# record but are deliberately NOT published: nothing in the site references
# them, so ignoring them changes nothing about how the page behaves.
PROMPT_*.md

# Task reports Claude Code writes back for the session that authored the briefs.
# The rule above only catches these by accident of naming — a report that does
# not start with PROMPT_ (the folder's own README.md, for one) would otherwise
# be published. Ignore the whole folder so the convention cannot leak.
tools/prompts/reportes/

# Dependency folders (in case tooling is added later)
node_modules/
